{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<sql-server>;Database=<database>;Trusted_Connection=True;TrustServerCertificate=False"
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200"
    ]
  },
  "Authentication": {
    "ApplyMigrationsOnStartup": false,
    "Jwt": {
      "Issuer": "SmartTaskManagement.Api",
      "Audience": "SmartTaskManagement.Client",
      "SigningKey": "<set-a-long-random-value-in-user-secrets-or-environment>",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14
    },
    "SeedAdmin": {
      "Email": "<development-admin-email>",
      "Password": "<development-admin-password>",
      "FirstName": "System",
      "LastName": "Administrator"
    }
  }
}
