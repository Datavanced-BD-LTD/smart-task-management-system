{
  "Authentication": {
    "ApplyMigrationsOnStartup": true,
    "Jwt": {
      "Issuer": "SmartTaskManagement.Api",
      "Audience": "SmartTaskManagement.Client",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
